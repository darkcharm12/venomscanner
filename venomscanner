#!/usr/bin/env bash
# venomscanner - launcher. Picks the Python engine (fast, asyncio) when python3
# is available, otherwise falls back to the pure-Bash engine.
#
#   venomscanner [--py | --bash] [scanner options] <target>
#
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SELF")"
ENGINE=auto
ARGS=()

for a in "$@"; do
    case $a in
        --py|--python) ENGINE=python ;;
        --bash)        ENGINE=bash ;;
        *)             ARGS+=("$a") ;;
    esac
done

have_python() {
    command -v python3 >/dev/null 2>&1 &&
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null &&
    [[ -f $DIR/venomscanner.py ]]
}

if [[ $ENGINE == auto ]]; then
    if have_python; then ENGINE=python; else ENGINE=bash; fi
fi

case $ENGINE in
    python)
        have_python || { echo "[x] python3 (>= 3.8) or venomscanner.py not found; try --bash" >&2; exit 1; }
        exec python3 "$DIR/venomscanner.py" ${ARGS[@]+"${ARGS[@]}"} ;;
    bash)
        [[ -f $DIR/venomscanner.sh ]] || { echo "[x] venomscanner.sh not found" >&2; exit 1; }
        exec bash "$DIR/venomscanner.sh" ${ARGS[@]+"${ARGS[@]}"} ;;
esac
